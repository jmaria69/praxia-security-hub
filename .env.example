# Praxia Security Hub Configuration
PRAXIA_ENV=development
PRAXIA_HOST=127.0.0.1
PRAXIA_PORT=8888
PRAXIA_SECRET_KEY=praxia-super-secret-key-change-in-production-min-32-chars-long
PRAXIA_JWT_ALGORITHM=HS256
PRAXIA_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Gateway Upstream Services
HEADROOM_URL=http://127.0.0.1:8787
OMNIROUTE_URL=http://127.0.0.1:20128
GATEWAY_FAIL_CLOSED=true
GATEWAY_MAX_PAYLOAD_MB=10

# BLA Software Protection Adapter
BLA_CLI_BIN=bla
BLA_DEFAULT_INTENSITY=balanced
BLA_AUTO_RESTORE_ON_FAILURE=true
BLA_STORAGE_DIR=/home/jmari/proyectosIA/praxia-security-hub/data/bla_storage

# Token Vault Security
TOKEN_VAULT_KEY=dGhpc2lzYTMyeGJ5dGVzZWNyZXRrZXlmb3J2YXVsdA==
TOKEN_VAULT_TTL_SECONDS=86400

# Audit Logging
AUDIT_LOG_DIR=/home/jmari/proyectosIA/praxia-security-hub/data/audit
AUDIT_STORAGE_DB=/home/jmari/proyectosIA/praxia-security-hub/data/praxia_security.db
